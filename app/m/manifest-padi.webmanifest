{
  "name": "Padi Emas Staff",
  "short_name": "Padi Emas Staff",
  "description": "Staff app for Padi Emas (Orbique FMS demo, made-up data)",
  "id": "/m/?co=padi",
  "start_url": "/m/?co=padi",
  "scope": "/m/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F4F5F7",
  "theme_color": "#F4F5F7",
  "icons": [
    {
      "src": "icons/padi-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/padi-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/padi-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/m/?share=slip",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "slip",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
